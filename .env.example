# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# BannerBear API Key and Template ID
BANNERBEAR_API_KEY=your_bannerbear_api_key_here
BANNERBEAR_TEMPLATE_ID=your_bannerbear_template_id_here

# Google Drive Folder ID (the ID from the folder URL)
# Example: If your folder URL is https://drive.google.com/drive/folders/1ABC123xyz
# Then your folder ID is: 1ABC123xyz
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Optional: Change the OpenAI model (default: gpt-4)
OPENAI_MODEL=gpt-4

# Optional: Number of slides (default: 5)
CAROUSEL_SLIDES=5